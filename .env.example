# NEAR ADGUARD environment template.
# Copy to .env.local and fill values there. Never commit .env.local.
# Values below are placeholders only.

# ---------------------------------------------------------------------------
# Public application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://dns.nearguard.biz.id

# ---------------------------------------------------------------------------
# Supabase (Free plan, Singapore)
# Project URL and anon key are safe to expose to the browser.
# Service-role key is server-only. Never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
# Direct or pooler connection string used by scripts/migrations. Keep secret.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Optional: Management API token for Supabase CLI / automation. Keep secret.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Bootstrap admin. This account is promoted once by scripts/bootstrap-admin.ts.
# There is no self-service admin registration.
FIRST_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Cryptographic keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep all of these secret and unique per environment.
# IP_ENC_KEY encrypts real IP addresses (AES-256-GCM).
# IP_HMAC_KEY groups IPs without storing plaintext.
# DEVICE_HMAC_KEY derives approximate device identifiers.
# DECOY_SECRET generates stable decoy IPs per device/time bucket.
# ---------------------------------------------------------------------------
IP_ENC_KEY=replace-with-base64-32-bytes
IP_HMAC_KEY=replace-with-base64-32-bytes
DEVICE_HMAC_KEY=replace-with-base64-32-bytes
DECOY_SECRET=replace-with-base64-32-bytes
# Optional extra pepper mixed into admin PIN hashes.
ADMIN_PIN_PEPPER=replace-with-random-string

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (Phase 5). Site key is public; secret is server-only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---------------------------------------------------------------------------
# Resend (Supabase Auth SMTP, Phase 5)
# Verify nearguard.biz.id in Resend and add its SPF/DKIM records at indo.domains.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=NEAR ADGUARD <noreply@nearguard.biz.id>

# ---------------------------------------------------------------------------
# Cron protection and Vercel usage reconciliation (Phase 7/13)
# VERCEL_TOKEN is optional. If set, the daily cron reconciles the circuit
# breaker with Vercel's billing usage API. Otherwise internal counters are used.
# ---------------------------------------------------------------------------
CRON_SECRET=replace-with-random-string
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-vercel-team-id
VERCEL_PROJECT_ID=your-vercel-project-id

# ---------------------------------------------------------------------------
# Blocklist sources
# URLhaus retired its keyless hostfile download on 21 October 2026. Set this
# only if you have an abuse.ch Auth-Key; otherwise the builder skips URLhaus.
# Never commit or print the key.
# ---------------------------------------------------------------------------
URLHAUS_API_KEY=

# ---------------------------------------------------------------------------
# DNS behavior
# ---------------------------------------------------------------------------
UPSTREAM_DOH_URL=https://cloudflare-dns.com/dns-query
UPSTREAM_FALLBACK_DOH_URL=https://dns.google/dns-query
BLOCK_MODE=NXDOMAIN

# ---------------------------------------------------------------------------
# Rate limits (admin-editable in the database after Phase 4)
# Free tier is per IP and shared by every device behind that IP.
# Registered tier is per account and shared across all of that account's devices.
# The per-device limit only stops one runaway device from starving the others.
# ---------------------------------------------------------------------------
RATE_FREE_PER_MIN=120
RATE_FREE_PER_DAY=3000
RATE_USER_PER_MIN=200
RATE_USER_PER_DAY=8000
RATE_DEVICE_PER_MIN=100
RATE_REGISTERED_IP_PER_MIN=300
RATE_UNKNOWN_PER_MIN=20
NEW_DEVICES_PER_HOUR=20

# ---------------------------------------------------------------------------
# Global circuit breaker against the Hobby 1,000,000 monthly invocation cap.
# Fractions of the cap: 0.60 = 600k, 0.75 = 750k, 0.90 = 900k, 0.95 = 950k.
# ---------------------------------------------------------------------------
HOBBY_MONTHLY_INVOCATIONS=1000000
CIRCUIT_BREAKER_FREE_SOFT=0.60
CIRCUIT_BREAKER_FREE_HARD=0.75
CIRCUIT_BREAKER_REGISTERED=0.90
CIRCUIT_BREAKER_ALL=0.95

# ---------------------------------------------------------------------------
# Retention and display defaults
# ---------------------------------------------------------------------------
DECOY_ROTATION_SECONDS=600
RETENTION_BLOCKED_EVENTS_DAYS=14
RETENTION_USAGE_DAILY_DAYS=90
RETENTION_IDLE_DEVICES_DAYS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
